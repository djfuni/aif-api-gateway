# AIF Chat 服务端配置
# 复制此文件为 .env 并填入你的配置

# ====================== 数据库 ======================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aifchat
DB_USER=root
DB_PASS=

# ====================== JWT 密钥 ======================
JWT_SECRET=请修改为随机的64位字符串
JWT_ACCESS_EXPIRES=3600        # Access Token 过期时间（秒）
JWT_REFRESH_EXPIRES=2592000    # Refresh Token 过期时间（秒，默认30天）

# ====================== AI API 配置（默认后端） ======================
# 移动端内置聊天使用的 AI 接口
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini


# ====================== 小米 MiMo Token Plan / API Platform ======================
# 用于模型别名 mimov2.5pro / mimo-v2.5-pro / mimo::mimov2.5pro
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=your_mimo_key_1
MIMO_DEFAULT_MODEL=mimo-v2.5-pro

# 小米 MiMo 二号密钥：用于 mimov2.5pro-key2 / mimo2::mimo-v2.5-pro，不覆盖第一套 MIMO_API_KEY
MIMO2_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO2_API_KEY=your_mimo_key_2
MIMO2_DEFAULT_MODEL=mimo-v2.5-pro

# ====================== 邮件服务（用于发送验证码） ======================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@email.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM=your@email.com
SMTP_FROM_NAME=AIF Chat

# ====================== 站点配置 ======================
SITE_URL=https://你的域名.com
SITE_NAME=AIF Chat
ADMIN_EMAIL=admin@example.com

# ====================== 安全与限流 ======================
RATE_LIMIT_PER_MINUTE=60      # 每分钟最大请求数（IP 级别）
